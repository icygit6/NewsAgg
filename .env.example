# NewsAgg environment variables. Copy the relevant blocks into server/.env and
# client/.env (both are gitignored). The scraper also reads server/.env.

# ─────────────────────────────────────────────────────────────────────────────
# SERVER  (server/.env)
# ─────────────────────────────────────────────────────────────────────────────

# Postgres / Neon connection string (DATABASE_URL and NEON_DSN are accepted aliases)
NEONDB_URL=

# JWT signing secret. REQUIRED in production (boot fails without it); a dev-only
# fallback is used otherwise. JWT_SECRET is an accepted alias.
SECRET_KEY=

# Runtime + networking
NODE_ENV=development
PORT=3001
# Comma-separated CORS allowlist, e.g. http://localhost:5173,https://app.example.com
# Dev: unset = reflect any origin. Prod: unset = same-origin only (never "*").
CLIENT_URL=
# Public base URL used to build links in password-reset / verify emails.
# Falls back to the first CLIENT_URL origin, then http://localhost:5173.
PUBLIC_CLIENT_URL=
# Set to 1 when behind a reverse proxy (nginx/Render/Railway) so rate limiting
# keys on the real client IP from X-Forwarded-For.
TRUST_PROXY=
# Escape hatch for self-signed Postgres TLS (skips certificate verification).
PGSSL_NO_VERIFY=

# Google Sign-In: the OAuth client ID (server verifies ID tokens against it)
GOOGLE_CLIENT_ID=

# Cloudflare Turnstile CAPTCHA (optional). Unset = CAPTCHA disabled (auth forms
# work with zero config). When set, register + forgot-password always challenge,
# and login challenges after repeated failures from the same IP.
TURNSTILE_SECRET=

# Third-party APIs
GEMINI_API_KEY=
GROQ_API_KEY=
MEM0_API_KEY=
FAVQS_API_KEY=
# HuggingFace token for the scraper's model downloads (optional; avoids rate limits)
HF_TOKEN=

# Logging: trace | debug | info | warn | error | fatal (default: info in prod, debug in dev)
LOG_LEVEL=

# Error monitoring (optional). Unset = disabled, nothing is sent off-box.
SENTRY_DSN=
SENTRY_ENV=
SENTRY_TRACES_SAMPLE_RATE=0

# Email delivery for password reset / verification. Unset SMTP_HOST = links are
# logged to the server console instead of sent (fine for local development).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=NewsAgg <no-reply@newsagg.local>

# ─────────────────────────────────────────────────────────────────────────────
# CLIENT  (client/.env) — only VITE_* vars are exposed to the browser
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the API server (default http://localhost:3001)
VITE_API_URL=
# Google Sign-In client ID (browser)
VITE_GOOGLE_CLIENT_ID=
# Cloudflare Turnstile site key (browser). Must be paired with TURNSTILE_SECRET
# on the server; unset = the CAPTCHA widget is not rendered.
VITE_TURNSTILE_SITE_KEY=
# Error monitoring (optional). Unset = disabled.
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0
